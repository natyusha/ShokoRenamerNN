<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>

    <Authors>natyusha</Authors>
    <RepositoryUrl>https://github.com/natyusha/ShokoRenamerNN</RepositoryUrl>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <PackageTags>relocation-provider, renamer</PackageTags>

    <PluginId>8b3d64c1-6b45-4b8a-9e7f-1d2a3b4c5d6e</PluginId>
    <Title>Shoko Renamer NN</Title>
    <Version>1.2.5</Version>
    <Description>A custom renamer plugin for Shoko Server which uses a strict AniDB only naming scheme within a flat folder structure.</Description>

    <ReleaseChannel Condition="'$(RELEASE_CHANNEL)' != ''">$(RELEASE_CHANNEL)</ReleaseChannel>
    <ReleaseChannel Condition="'$(RELEASE_CHANNEL)' == ''">Dev</ReleaseChannel>

    <!-- Default to Stable (0) and If the Release Channel is Dev (set via GitHub Actions), use revision 1 to trigger Shoko's Dev Channel detection -->
    <BuildRevision>0</BuildRevision>
    <BuildRevision Condition="'$(ReleaseChannel)' == 'Dev'">1</BuildRevision>

    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
    <InformationalVersion Condition="'$(BuildRevision)' == '1'">$(Version)-dev.1</InformationalVersion>
  </PropertyGroup>

  <!-- Embed Identity Metadata manually to satisfy Shoko Server's pre-load checks -->
  <ItemGroup>
    <AssemblyMetadata Include="PackageID" Value="$(PluginId)" />
    <AssemblyMetadata Include="PackageName" Value="$(Title)" />
    <AssemblyMetadata Include="PackageOverview" Value="$(Description)" />
  </ItemGroup>

  <!-- Generate C# identity constants to DRY properties across project and runtime reflection -->
  <Target Name="GenerateRenamerConstants" BeforeTargets="BeforeCompile;CoreCompile;CompileDesignTime">
    <PropertyGroup>
      <_GeneratedConstantsFile>$(IntermediateOutputPath)ShokoRenamerNNConstants.g.cs</_GeneratedConstantsFile>
      <_GeneratedConstantsCode>
        <![CDATA[// <auto-generated />
namespace ShokoRenamerNN%3B

/// <summary>Centralized constants for plugin identity and metadata.</summary>
public static partial class ShokoRenamerNNConstants
{
    /// <summary>Display name of the plugin.</summary>
    public const string Name = "$(Title)"%3B

    /// <summary>Description of the plugin.</summary>
    public const string Description = "$(Description)"%3B

    /// <summary>Current version string.</summary>
    public const string Version = "$(Version)"%3B

    /// <summary>Unique plugin ID used for configuration storage.</summary>
    public const string PluginId = "$(PluginId)"%3B
}
        ]]>
      </_GeneratedConstantsCode>
    </PropertyGroup>

    <MakeDir Directories="$(IntermediateOutputPath)" Condition="!Exists('$(IntermediateOutputPath)')" />
    <WriteLinesToFile File="$(_GeneratedConstantsFile)" Lines="$(_GeneratedConstantsCode)" Overwrite="true" WriteOnlyWhenDifferent="true" Encoding="UTF-8" />

    <ItemGroup>
      <Compile Include="$(_GeneratedConstantsFile)" />
      <FileWrites Include="$(_GeneratedConstantsFile)" />
    </ItemGroup>
  </Target>
</Project>
